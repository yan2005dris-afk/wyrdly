# ==============================================
# Wyrdly - Environment Variables Template
# ==============================================
#
# Copy this file to .env for local development and to /etc/wyrdly/.env
# on the production server. Production deployment reads /etc/wyrdly/.env
# first, then falls back to ./.env in the checkout
# (see .github/workflows/deploy.yml).
#
# Legend:
#   [REQUIRED]  No safe default; the service will fail or be insecure without it.
#   [PROD]      Local-safe default but MUST be overridden in production.
#
# This template covers variables consumed by compose.yaml AND
# wyrdly-backend/src/main/resources/application.properties. It includes
# the new env vars introduced by PR #81 (S3 region/path-style, secure
# cookies) and by HU11 (Web Push VAPID).
# ------------------------------------------------------------

# ---------------- Neo4j Database ----------------
NEO4J_URI=bolt://wyrdly-neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change_this_neo4j_password          # [REQUIRED] Strong secret in prod

# ---------------- RustFS / S3 -------------------
# Endpoint of the S3-compatible object storage. Use
# https://s3.<region>.amazonaws.com if migrating to real AWS S3.
RUSTFS_ENDPOINT=http://wyrdly-rustfs:9000
RUSTFS_ACCESS_KEY=change_this_rustfs_access_key     # [REQUIRED]
RUSTFS_SECRET_KEY=change_this_rustfs_secret_key     # [REQUIRED]
RUSTFS_BUCKET=social-media-assets
RUSTFS_REGION=us-east-1                             # [PROD] PR #81 - match your bucket region
RUSTFS_FORCE_PATH_STYLE=true                        # [PROD] PR #81 - true for RustFS/MinIO, false for AWS S3

# ---------------- JWT Security ------------------
# Issuer claim must match the `iss` of emitted tokens.
JWT_ISSUER=https://wyrdly.com/issuer
JWT_KEYS_DIR=./jwt                                  # Generate with: bash scripts/generate-jwt-keys.sh ./jwt
JWT_PUBLIC_KEY_LOCATION=file:///deployments/jwt/publicKey.pem
JWT_PRIVATE_KEY_LOCATION=file:///deployments/jwt/privateKey.pem

# ---------------- Application Ports -------------
# Host-side ports published by docker compose. In production the ADR-006
# recommends removing internal-service ports (Neo4j, RustFS, Redis,
# backend) from the host and keeping only the frontend for ingress.
BACKEND_PORT=8080
FRONTEND_PORT=3000
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
RUSTFS_API_PORT=9000
RUSTFS_CONSOLE_PORT=9001
REDIS_PORT=6379

# ---------------- Auth Cookies ------------------
# Cookies must be Secure in production so the refresh token only travels over HTTPS.
AUTH_COOKIE_SECURE=true                             # [PROD] PR #81 - MUST be true behind HTTPS
AUTH_COOKIE_SAME_SITE=LAX                           # Use NONE for cross-site (requires Secure=true)
AUTH_REFRESH_TOKEN_MAX_AGE=604800                   # 7 days, in seconds

# ---------------- Application URLs --------------
# Public base URL used by MediaService to build absolute file URLs
# returned in MediaUploadResponse.fileUrl. Must be reachable by clients.
APP_PUBLIC_BASE_URL=http://localhost:8080           # [PROD] e.g. https://api.wyrdly.app

# ---------------- CORS Origins ------------------
# List exactly the frontend origins. Wildcard (*) is NOT allowed because
# wyrdly.http.cors.access-control-allow-credentials=true. Production must
# include the real domain, e.g. https://wyrdly.yandro.tech.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:80

# ---------------- Web Push VAPID (HU11) ---------
# P-256 keypair generated on first run by init-vapid-keys.sh.
# Volume ./vapid:/deployments/vapid persists the keys between restarts.
VAPID_PUBLIC_KEY_LOCATION=/deployments/vapid/publicKey.txt
VAPID_PRIVATE_KEY_LOCATION=/deployments/vapid/privateKey.txt
VAPID_SUBJECT=mailto:ops@wyrdly.com                 # [PROD] Real ops contact email
VAPID_GENERATE_IF_MISSING=true                      # Idempotent bootstrap on first run
VAPID_KEYS_DIR=./vapid
# Push dispatcher + follower fan-out (NEW_POST_FROM_FOLLOWED). Bounded queue:
# pushes beyond capacity are dropped and counted as wyrdly_push_dispatch{result="rejected"}.
PUSH_DISPATCH_POOL_SIZE=8
PUSH_DISPATCH_QUEUE_CAPACITY=5000
PUSH_FANOUT_BATCH_SIZE=200                          # Followers read + dispatched per batch
PUSH_FANOUT_MAX_RECIPIENTS=10000                    # Cap per post (celebrity guard)

# ---------------- Redis -------------------------
# Idempotency keys + rate-limit counters (HU09 reactions).
REDIS_HOSTS=redis://wyrdly-redis:6379

# ---------------- Database Tuning ---------------
# Sized for >= 5k concurrent reactions per the HU09 fan-out target.
NEO4J_MAX_POOL_SIZE=300

# ---------------- Cache / Rate Limit ------------
# Follow-relation cache TTL and request-rate history window.
FOLLOW_CACHE_TTL_SECONDS=300
RATE_LIMIT_HISTORY_REQUESTS_PER_MINUTE=60

# ---------------- Seeder ------------------------
# Dev seed pre-populates Neo4j with demo users/edges. MUST be false in prod.
WYRDLY_SEED_ENABLED=true                            # [PROD] MUST be false

# ---------------- Cloudflare Tunnel -------------
# Token from `cloudflared tunnel create wyrdly`. The cloudflared container
# is the only path that should reach the frontend from the public internet.
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token_here   # [REQUIRED]
