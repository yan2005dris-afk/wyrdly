# =============================================================================
# Wyrdly — Local Development .env (DO NOT use as-is in production)
# -----------------------------------------------------------------------------
# Copy this file to .env and run: docker compose up -d --build
#
# Every variable below is set to a SAFE-OR-EQUIVALENT-LOCAL value. The
# PROD-EXPECTED value is shown in a comment so you know what to swap when
# you cut a release.
#
# The complete production contract — including variables NOT needed in dev —
# lives in `.env.prod`. Diff the two when promoting.
# =============================================================================


# ────────────────────────────────────────────────────────────────────────────
# NEO4J — Graph Database
# ────────────────────────────────────────────────────────────────────────────
# PROD-EXPECTED: bolt://wyrdly-neo4j:7687
NEO4J_URI=bolt://wyrdly-neo4j:7687
# PROD-EXPECTED: neo4j (or a dedicated app user)
NEO4J_USERNAME=neo4j
# PROD-EXPECTED: strong 32+ chars (openssl rand -base64 36)
NEO4J_PASSWORD=local_dev_password
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
# Browser UI on for local exploration.
# PROD-EXPECTED: false
NEO4J_HEAP_MAX=1g
NEO4J_MAX_POOL_SIZE=50


# ────────────────────────────────────────────────────────────────────────────
# RUSTFS — S3-compatible Object Storage
# ────────────────────────────────────────────────────────────────────────────
# PROD-EXPECTED: http://wyrdly-rustfs:9000
RUSTFS_ENDPOINT=http://wyrdly-rustfs:9000
# PROD-EXPECTED: random 32+ chars
RUSTFS_ACCESS_KEY=rustfsadmin
# PROD-EXPECTED: random 64+ chars
RUSTFS_SECRET_KEY=rustfssecret123
RUSTFS_BUCKET=social-media-assets
RUSTFS_REGION=us-east-1
RUSTFS_FORCE_PATH_STYLE=true
RUSTFS_API_PORT=9000
RUSTFS_CONSOLE_PORT=9001


# ────────────────────────────────────────────────────────────────────────────
# REDIS — Idempotency + Rate Limiting
# ────────────────────────────────────────────────────────────────────────────
REDIS_HOSTS=redis://wyrdly-redis:6379
# Local binds to all interfaces so docker compose port mapping works.
# PROD-EXPECTED: 127.0.0.1
REDIS_BIND=0.0.0.0
REDIS_PORT=6379
REDIS_LOGLEVEL=notice
REDIS_MAXMEMORY=256mb
REDIS_MAXMEMORY_POLICY=allkeys-lru


# ────────────────────────────────────────────────────────────────────────────
# BACKEND — Quarkus (Java 21)
# ────────────────────────────────────────────────────────────────────────────
# Default to dev profile locally; production `.env.prod` forces prod.
# PROD-EXPECTED: prod
QUARKUS_PROFILE=dev
# Bind to loopback; backend is reached via cloudflared or the frontend nginx.
# PROD-EXPECTED: 127.0.0.1
BACKEND_BIND=127.0.0.1
# In dev: 8080 (the SPA Vite proxy hits this). In prod: 18080 (must differ
# from FRONTEND_PORT=8080 because both services run on the same host).
# PROD-EXPECTED: 18080
BACKEND_PORT=8080
# Comma-separated. Include localhost for the SPA + curl-based testing.
# PROD-EXPECTED: https://wyrdly.yandro.tech (no localhost)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:80,https://wyrdly.yandro.tech
# Local is HTTP → cookies must be non-secure.
# PROD-EXPECTED: true
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax
AUTH_COOKIE_PATH=/
AUTH_REFRESH_TOKEN_MAX_AGE=604800
# Used by the backend to build absolute media URLs in responses.
# PROD-EXPECTED: https://api.wyrdly.yandro.tech
APP_PUBLIC_BASE_URL=http://localhost:8080
# PROD-EXPECTED: https://api.wyrdly.yandro.tech
JWT_ISSUER=https://wyrdly.com/issuer
# SmallRye JWT — paths inside the container; file:// prefix is required.
JWT_PUBLIC_KEY_LOCATION=file:///deployments/jwt/publicKey.pem
JWT_PRIVATE_KEY_LOCATION=file:///deployments/jwt/privateKey.pem
# Host directory mounted into the backend container. Generate once with:
# ./scripts/generate-jwt-keys.sh ./jwt
# PROD-EXPECTED: /etc/wyrdly/jwt
JWT_KEYS_DIR=./jwt
# VAPID Web Push
VAPID_SUBJECT=mailto:ops@wyrdly.com
# PROD-EXPECTED: false (keys must be pre-provisioned in prod)
VAPID_GENERATE_IF_MISSING=true
VAPID_PUBLIC_KEY_LOCATION=/deployments/vapid/publicKey.txt
VAPID_PRIVATE_KEY_LOCATION=/deployments/vapid/privateKey.txt
# PROD-EXPECTED: /etc/wyrdly/vapid
VAPID_KEYS_DIR=./vapid
# Push dispatcher tuning (same defaults in both envs).
PUSH_DISPATCH_POOL_SIZE=8
PUSH_DISPATCH_QUEUE_CAPACITY=5000
PUSH_FANOUT_BATCH_SIZE=200
PUSH_FANOUT_MAX_RECIPIENTS=10000
# Seed data — ON by default in local dev for quick exploration.
# PROD-EXPECTED: false
WYRDLY_SEED_ENABLED=true
QUARKUS_LOG_LEVEL=DEBUG
# QUARKUS_LOG_CONSOLE_FORMAT — uses Quarkus DEFAULT format.
# Uncomment the line below to override with a custom JBoss LogManager format.
# Note: JBoss LogManager requires padding numbers on %p (e.g. %-5p).
# QUARKUS_LOG_CONSOLE_FORMAT=%d{yyyy-MM-dd HH:mm:ss,SSS} %-5p [%c{2}] (%t) %s%e%n


# ────────────────────────────────────────────────────────────────────────────
# FRONTEND — React SPA (build-time injection)
# ────────────────────────────────────────────────────────────────────────────
# Frontend bind address (host loopback) and internal port.
# In dev: 3000 (the dev SPA listens here). In prod: 8080 (Cloudflare Tunnel
# reaches the Nginx on this port). Must NOT collide with BACKEND_PORT.
# PROD-EXPECTED: 8080
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=3000
# Backend HTTP origin used by the SPA. PROXY DEV: Vite dev server proxies /api
# and /ws to this URL.
# PROD-EXPECTED: https://api.wyrdly.yandro.tech
VITE_BACKEND_URL=http://localhost:8080
# WebSocket origin.
# PROD-EXPECTED: wss://api.wyrdly.yandro.tech
VITE_WS_URL=ws://localhost:8080
VITE_API_BASE_URL=


# ────────────────────────────────────────────────────────────────────────────
# CLOUDFLARE TUNNEL — optional, only if you expose the app publicly
# -----------------------------------------------------------------------------
# Use a fake token locally and rely on the cloudflared container being absent
# (it has profiles: ["cloudflare"], so `docker compose up` won't start it).
# To enable: docker compose --profile cloudflare up -d
# -----------------------------------------------------------------------------
# PROD-EXPECTED: real Cloudflare tunnel token
CLOUDFLARE_TUNNEL_TOKEN=dummy_local_token
