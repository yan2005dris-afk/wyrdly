  "cards": [
    {
      "dot": "cyan",
      "title": "Capa de Negocio y Transporte (TRD §3)",
      "items": [
        "HTTP/REST: Cargas útiles JSON autenticadas mediante cabecera Authorization: Bearer <JWT>.",
        "WebSocket (RFC 6455): Canal TCP persistente full-duplex con @ServerEndpoint y validación token @OnOpen.",
        "Web Push (RFC 8030/8291/8292): Notificaciones asíncronas firmadas con claves VAPID fuera del ciclo de vida de la pestaña."
      ]
    },
    {
      "dot": "emerald",
      "title": "Capa de Persistencia Segregada (TRD §2)",
      "items": [
        "Neo4j 5.x: Recorridos relacionales profundos (amigos de amigos, feed) sin costo computacional de múltiples JOINs.",
        "Object Storage (MinIO/RustFS): Desacopla archivos binarios pesados (imágenes/videos) para no saturar la base de datos de grafos.",
        "Protocolo Bolt: Comunicación binaria de alto rendimiento Quarkus-Neo4j por puerto :7687."
      ]
    },
    {
      "dot": "rose",
      "title": "Entorno y Despliegue Distribuido (TRD §4)",
      "items": [
        "Docker Compose: Orquestación reproducible en red virtual aislada wyrdly-network.",
        "Healthchecks: Verificación estricta de disponibilidad en Neo4j (cypher-shell) y S3 (HTTP) antes de iniciar Quarkus.",
        "Frontend desacoplado: Servido en puerto 3000 con consumo de API y registro de Service Worker."
      ]
    }
  ]
