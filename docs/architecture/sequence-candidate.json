  "cards": [
    {
      "dot": "emerald",
      "title": "Direct-to-S3 Presigned Upload (ADR-003)",
      "items": [
        "El cliente solicita una URL de subida prefirmada con expiración corta.",
        "Los binarios viajan directamente entre el navegador y RustFS/S3.",
        "Se protege la memoria heap de Quarkus frente a cargas masivas concurrentes."
      ]
    },
    {
      "dot": "cyan",
      "title": "Persistencia de Grafos en Neo4j",
      "items": [
        "La creación del post y la relación [:PUBLICA] es atómica vía Cypher.",
        "Las consultas de feed recorren [:SIGUE] sin JOINs relacionales costosos.",
        "Los recuentos de reacciones [:REACCIONA] se calculan en la misma pasada."
      ]
    },
    {
      "dot": "rose",
      "title": "Notificaciones Asíncronas VAPID",
      "items": [
        "Quarkus no bloquea la respuesta REST para despachar notificaciones.",
        "Las credenciales VAPID autentican al servidor emisor ante Google FCM / Mozilla.",
        "El Service Worker despierta en el cliente y renderiza la notificación nativa."
      ]
    }
  ]
