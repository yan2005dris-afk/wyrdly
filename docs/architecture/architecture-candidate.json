  "cards": [
    {
      "dot": "cyan",
      "title": "Topología y Microservicios",
      "items": [
        "Frontend: SPA React 18 + Vite estructurado bajo Screaming Architecture y FSD.",
        "Backend: Quarkus 3.x (Java 21) reactivo con arquitectura Onion / DDD por capas.",
        "Grafo Neo4j 5.26: Persistencia relacional de alta velocidad para perfiles, feed y seguidores.",
        "Storage RustFS: Almacenamiento de objetos binarios de alto desempeño compatible con AWS S3."
      ]
    },
    {
      "dot": "emerald",
      "title": "Protocolos de Comunicación",
      "items": [
        "REST API: Operaciones CRUD autenticadas vía cabecera Authorization: Bearer <JWT>.",
        "WebSockets: Comunicación bidireccional continua en /ws/chat para mensajería instantánea.",
        "Bolt Protocol: Canal binario nativo de alta eficiencia entre Quarkus y Neo4j en puerto 7687.",
        "S3 API: Integración mediante AWS SDK v2 sobre HTTP en puerto 9000 para multimedia."
      ]
    },
    {
      "dot": "rose",
      "title": "Notificaciones Web Push (VAPID)",
      "items": [
        "Desacoplamiento asíncrono según RFC 8030 / RFC 8291 firmado con claves VAPID.",
        "Al publicar un post, Quarkus recorre el grafo de seguidores y envía alertas al servidor Push.",
        "El Service Worker recibe el evento push en segundo plano e interactúa con el sistema operativo."
      ]
    }
  ]
