{
  "title": "HU11 Web Push Notifications",
  "uid": "hu11-web-push",
  "schemaVersion": 38,
  "tags": ["wyrdly", "notifications", "push", "hu11"],
  "timezone": "browser",
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Push Dispatch Rate by Result",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by (result) (rate(wyrdly_push_dispatch_total[5m]))",
          "legendFormat": "{{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Active Push Subscriptions",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "wyrdly_push_subscriptions",
          "legendFormat": "Subscriptions"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Rate Limited Percentage",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "sum(rate(wyrdly_push_dispatch_total{result=\"rate_limited\"}[5m])) / clamp_min(sum(rate(wyrdly_push_dispatch_total[5m])), 1) * 100",
          "legendFormat": "Rate Limited %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 20 }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Push Gateway Latency (p50 / p95 / p99)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(wyrdly_push_dispatch_duration_seconds_bucket{result=\"ok\"}[5m]))) * 1000",
          "legendFormat": "p50 (ms)"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(wyrdly_push_dispatch_duration_seconds_bucket{result=\"ok\"}[5m]))) * 1000",
          "legendFormat": "p95 (ms)"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(wyrdly_push_dispatch_duration_seconds_bucket{result=\"ok\"}[5m]))) * 1000",
          "legendFormat": "p99 (ms)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Average Encrypted Payload Size",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "rate(wyrdly_push_dispatch_bytes_sum[5m]) / rate(wyrdly_push_dispatch_bytes_count[5m])",
          "legendFormat": "avg payload bytes"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      }
    }
  ]
}
