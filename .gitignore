# .gitignore
target/
*.class
.idea/
*.iml
.vscode/
node_modules/
dist/
# Ignore all env files by default. Real secrets must NEVER be committed.
.env
.env.*
# Allow the two committed templates (dev + prod contracts).
!.env.dev
!.env.prod
.DS_Store
*.log
__pycache__/
*.pyc
generate_docx.py
coverage/
*.pem
*.key
jwt/
# HU11 / TASK-01 (#62) — VAPID keypair location. Never commit key material.
vapid/
/deployments/vapid/

# Local tooling artifacts (not for committing)
.atl/
.codegraph/
.claude/
e2e-report.*
reports/
