# =============================================================================
# Wyrdly — PRODUCTION Environment Template
# -----------------------------------------------------------------------------
# Copy this file to /etc/wyrdly/.env on the production host, replace every
# placeholder with the real value, then run:
#
#   docker compose --env-file /etc/wyrdly/.env up -d --build
#
# Every line below shows the variable and the EXPECTED production value as a
# comment. NEVER commit the populated file — it is in .gitignore.
#
# Generate strong secrets with:
#   openssl rand -hex 32     # 64 hex chars
#   openssl rand -base64 48  # 64 base64 chars
# =============================================================================


# ────────────────────────────────────────────────────────────────────────────
# NEO4J — Graph Database
# ────────────────────────────────────────────────────────────────────────────
# Bolt URI reachable from inside the wyrdly-network.
# Expected: bolt://wyrdly-neo4j:7687 (do NOT change — compose resolves it).
NEO4J_URI=bolt://wyrdly-neo4j:7687

# Database user. The default neo4j is fine but creating a dedicated user is
# stronger. Expected: neo4j (or a dedicated app user).
NEO4J_USERNAME=neo4j

# Database password. Expected: strong, ≥ 32 chars, rotated every 90 days.
# Generate: openssl rand -base64 36
NEO4J_PASSWORD=__SET_ME_NEO4J_PASSWORD__

# Host port mapping. Bind to loopback only in prod (default 127.0.0.1:7474).
# Expected: 7474 (HTTP Browser UI, firewall-restricted)
NEO4J_HTTP_PORT=7474
# Expected: 7687 (Bolt — backend only)
NEO4J_BOLT_PORT=7687

# Disable the Neo4j Browser in prod. The Browser is for local development.
# Expected: false
# TLS policy for the embedded HTTPS connector. In prod prefer "browser_only"
# (encrypt only the Browser UI) or "strict" (encrypt everything).

# JVM heap for Neo4j. Tune to your workload.
# Expected: 1g / 4g (small / medium)
NEO4J_HEAP_INITIAL=1g
NEO4J_HEAP_MAX=4g

# Driver connection pool size (matches application.properties).
# Expected: 100–500 depending on concurrency.
NEO4J_MAX_POOL_SIZE=300


# ────────────────────────────────────────────────────────────────────────────
# RUSTFS — S3-compatible Object Storage
# ────────────────────────────────────────────────────────────────────────────
# Endpoint reachable from inside the wyrdly-network.
# Expected: http://wyrdly-rustfs:9000
RUSTFS_ENDPOINT=http://wyrdly-rustfs:9000

# S3 access key. Expected: 32+ chars, unique per environment.
# Generate: openssl rand -hex 16
RUSTFS_ACCESS_KEY=__SET_ME_RUSTFS_ACCESS_KEY__

# S3 secret key. Expected: 64+ chars.
# Generate: openssl rand -base64 48
RUSTFS_SECRET_KEY=__SET_ME_RUSTFS_SECRET_KEY__

# Bucket that holds all user-uploaded media (avatars, photos).
# Expected: social-media-assets (or your own bucket name)
RUSTFS_BUCKET=social-media-assets

# Region is required by the S3 SDK even if RustFS ignores it.
# Expected: us-east-1 (or any ISO region string)
RUSTFS_REGION=us-east-1

# RustFS is single-node S3-compatible and exposes path-style URLs.
# Expected: true
RUSTFS_FORCE_PATH_STYLE=true

# Host port mapping. Bind to loopback in prod.
# Expected: 9000
RUSTFS_API_PORT=9000
# Expected: 9001 (Web Console, firewall-restricted)
RUSTFS_CONSOLE_PORT=9001


# ────────────────────────────────────────────────────────────────────────────
# REDIS — Idempotency + Rate Limiting
# ────────────────────────────────────────────────────────────────────────────
# Endpoint reachable from inside the wyrdly-network.
# Expected: redis://wyrdly-redis:6379
REDIS_HOSTS=redis://wyrdly-redis:6379

# Bind address for the host port mapping. Loopback in prod.
# Expected: 127.0.0.1
REDIS_BIND=127.0.0.1

# Host port. Expected: 6379
REDIS_PORT=6379

# Loglevel. Expected: warning (or notice)
REDIS_LOGLEVEL=warning

# Memory ceiling. Expected: 256mb / 512mb / 1gb (tune to your limits).
REDIS_MAXMEMORY=512mb

# Eviction policy. Expected: allkeys-lru
REDIS_MAXMEMORY_POLICY=allkeys-lru


# ────────────────────────────────────────────────────────────────────────────
# BACKEND — Quarkus (Java 21)
# ────────────────────────────────────────────────────────────────────────────
# Quarkus profile. Forces the %prod. block in application.properties.
# Expected: prod
QUARKUS_PROFILE=prod

# Backend bind address (host loopback) and internal port.
# The host port MUST differ from FRONTEND_PORT (8080) when both run on the
# same host. Frontend owns :8080 (public entry via Cloudflare Tunnel);
# the backend lives on a non-public port for ops/smoke testing only. The
# Nginx reverse proxy inside the frontend container talks to the backend
# over the wyrdly-network (wyrdly-backend:8080), not via this host port.
# Expected: 127.0.0.1 / 18080
BACKEND_BIND=127.0.0.1
BACKEND_PORT=18080

# Comma-separated list of allowed CORS origins. NO localhost in prod.
# This is the ONLY required override to switch from dev to prod.
# Expected: https://wyrdly.yandro.tech,https://www.wyrdly.yandro.tech
CORS_ORIGINS=https://wyrdly.yandro.tech,https://www.wyrdly.yandro.tech

# ── HTTP / Cookies ────────────────────────────────────────────────────────
# Cookies must be secure in prod (HTTPS only).
# Expected: true
AUTH_COOKIE_SECURE=true

# SameSite policy. Same eTLD+1 across front/back → Lax.
# Cross-site (api.x.com, app.x.com) → None (requires Secure=true).
# Expected: Lax (or None if cross-site)
AUTH_COOKIE_SAME_SITE=Lax

# Cookie path. Expected: /
AUTH_COOKIE_PATH=/

# Refresh-token TTL in seconds. 7 days = 604800.
# Expected: 604800 (7d) / 2592000 (30d)
AUTH_REFRESH_TOKEN_MAX_AGE=604800

# ── Public URLs ───────────────────────────────────────────────────────────
# Absolute base URL the backend uses to build absolute URLs in responses
# (e.g. media fileUrl). Required.
# Expected: https://api.wyrdly.yandro.tech
APP_PUBLIC_BASE_URL=https://api.wyrdly.yandro.tech

# JWT issuer claim. Must match what the backend signs and what clients verify.
# Expected: https://api.wyrdly.yandro.tech (or your own issuer URL)
JWT_ISSUER=https://api.wyrdly.yandro.tech

# ── SmallRye JWT (RSA keypair) ────────────────────────────────────────────
# Path inside the container. file:// prefix is required by SmallRye.
# Expected: file:///deployments/jwt/publicKey.pem
JWT_PUBLIC_KEY_LOCATION=file:///deployments/jwt/publicKey.pem
# Expected: file:///deployments/jwt/privateKey.pem
JWT_PRIVATE_KEY_LOCATION=file:///deployments/jwt/privateKey.pem

# Host directory holding the RSA keypair (mounted into the backend container).
# Generate once with: ./scripts/generate-jwt-keys.sh /etc/wyrdly/jwt
# Expected: /etc/wyrdly/jwt
JWT_KEYS_DIR=/etc/wyrdly/jwt

# ── Web Push VAPID ────────────────────────────────────────────────────────
# Contact URL for push providers (mailto: or https:).
# Expected: mailto:ops@wyrdly.yandro.tech
VAPID_SUBJECT=mailto:ops@wyrdly.yandro.tech

# Generate-if-missing. Set to false in prod: keys must be provisioned
# up-front and reviewed before the first deploy.
# Expected: false
VAPID_GENERATE_IF_MISSING=false

# Path inside the container. Expected: /deployments/vapid/publicKey.txt
VAPID_PUBLIC_KEY_LOCATION=/deployments/vapid/publicKey.txt
# Expected: /deployments/vapid/privateKey.txt
VAPID_PRIVATE_KEY_LOCATION=/deployments/vapid/privateKey.txt

# Host directory holding the VAPID keypair (mounted into the backend container).
# Provision with: ./scripts/generate-vapid-keys.sh /etc/wyrdly/vapid
# Expected: /etc/wyrdly/vapid
VAPID_KEYS_DIR=/etc/wyrdly/vapid

# ── Push dispatcher tuning ────────────────────────────────────────────────
# Worker pool size. Expected: 8–32 depending on subscriber fan-out.
PUSH_DISPATCH_POOL_SIZE=16
# Bounded queue. Expected: 5000–20000.
PUSH_DISPATCH_QUEUE_CAPACITY=10000
# Batch size for follower fan-out. Expected: 100–500.
PUSH_FANOUT_BATCH_SIZE=200
# Hard cap on recipients per push. Expected: 10000.
PUSH_FANOUT_MAX_RECIPIENTS=10000

# ── Seed data ────────────────────────────────────────────────────────────
# Set to true ONLY on the very first deploy if you want the dev seed users.
# Leave false in every other case.
# Expected: false
WYRDLY_SEED_ENABLED=false

# ── Logging ──────────────────────────────────────────────────────────────
# Root log level. Expected: INFO (or WARN in steady state).
QUARKUS_LOG_LEVEL=INFO
# Log line format. Expected: ISO timestamp + level + category + thread + message.
# QUARKUS_LOG_CONSOLE_FORMAT — uses Quarkus DEFAULT format (safe).
# Uncomment the line below to override with a custom JBoss LogManager format.
# Note: JBoss LogManager requires padding numbers on %p (e.g. %-5p).
# QUARKUS_LOG_CONSOLE_FORMAT=%d{yyyy-MM-dd HH:mm:ss,SSS} %-5p [%c{2}] (%t) %s%e%n


# ────────────────────────────────────────────────────────────────────────────
# FRONTEND — React SPA (build-time injection)
# ────────────────────────────────────────────────────────────────────────────
# Frontend bind address (host loopback) and internal port.
# The frontend Nginx is the public entry point — Cloudflare Tunnel reaches
# it on this host port. Must NOT collide with BACKEND_PORT.
# Expected: 127.0.0.1 / 8080
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=8080

# VITE_BACKEND_URL: HTTP base URL the SPA calls. Absolute.
# Expected: https://api.wyrdly.yandro.tech
VITE_BACKEND_URL=https://api.wyrdly.yandro.tech

# VITE_WS_URL: WebSocket base URL. wss:// in prod.
# Expected: wss://api.wyrdly.yandro.tech
VITE_WS_URL=wss://api.wyrdly.yandro.tech

# VITE_API_BASE_URL: usually empty in prod (the SPA talks to the same origin
# via Nginx reverse proxy). Set only if you bypass the proxy.
# Expected: ""
VITE_API_BASE_URL=


# ────────────────────────────────────────────────────────────────────────────
# CLOUDFLARE TUNNEL (only if you expose the app via Cloudflare)
# Activate the service with: CLOUDFLARE_ENABLED=true; the deploy workflow
# adds `--profile cloudflare` automatically.
# ────────────────────────────────────────────────────────────────────────────
# Enable the cloudflared container in production. Expected: true
CLOUDFLARE_ENABLED=true
# Token from Cloudflare Zero Trust dashboard → Tunnels → your tunnel.
# Expected: 64+ char Cloudflare tunnel token
CLOUDFLARE_TUNNEL_TOKEN=__SET_ME_CLOUDFLARE_TUNNEL_TOKEN__